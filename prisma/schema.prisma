generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id              String    @id @default(cuid())
  name            String
  portalUrl       String
  macAddress      String
  serialNumber    String?
  // Device identity below: some Stalker/Ministra portals bind a session to the exact
  // device_id/device_id2/signature/hw_version captured from the real STB, not a value
  // derived from mac/serial. Optional — only send what the provider actually requires.
  stbType         String?
  clientType      String?
  deviceId        String?
  deviceId2       String?
  signature       String?
  hwVersion       String?
  hwVersion2      String?
  prehash         String?
  imageVersion    String?
  apiSignature    String?
  timezone        String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastConnectedAt DateTime?
}

enum ContentType {
  CHANNEL
  MOVIE
  EPISODE
}

model Favorite {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId   String
  contentType ContentType
  contentId   String
  cmd         String?
  title       String
  createdAt   DateTime    @default(now())

  @@unique([userId, profileId, contentType, contentId])
  @@index([userId, profileId, contentType])
}

model WatchHistory {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId   String
  // Live channels don't get history rows, only VOD/series playback.
  contentType ContentType
  contentId   String
  seriesId    String?
  title       String
  seriesTitle String?
  positionSec Int         @default(0)
  durationSec Int?
  cmd         String
  updatedAt   DateTime    @updatedAt
  createdAt   DateTime    @default(now())

  @@unique([userId, profileId, contentType, contentId])
  @@index([userId, profileId, updatedAt])
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]
  favorites     Favorite[]
  watchHistory  WatchHistory[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
